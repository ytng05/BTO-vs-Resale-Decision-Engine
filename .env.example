# Copy to .env (never commit .env)
PORT=3000
# Leave MONGODB_URI empty to run without a database (health, ruleset and stubs still work)
MONGODB_URI=
JWT_SECRET=change-me
# data.gov.sg: register for an API key (rate limits now apply). Confirm base URL and header in the current developer guide.
DATAGOV_API_KEY=
DATAGOV_BASE_URL=
# OneMap: free registration
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# Feature flags
FEATURE_TIMING_OPTIMISER=true
FEATURE_STRATEGY_SEARCH=true
FEATURE_BACKTEST=false

DATAGOV_API_KEY=
ONEMAP_EMAIL=
 ONEMAP_PASSWORD=
